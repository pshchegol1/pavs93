@{
    string msg = Context.Request.Query["m"];
    var checkAlertMessage = TempData["CheckAlertMessage"] as string;
    var checkAlertType = TempData["CheckAlertType"] as string;
    var checkAlertClass = checkAlertType == "success" ? "alert-success" : "alert-danger";
    var checkAlertIcon = checkAlertType == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill";
}

@if (!string.IsNullOrEmpty(checkAlertMessage))
{
    <div class="alert @checkAlertClass alert-dismissible fade show" role="alert">
        <strong><i class="bi @checkAlertIcon"></i></strong> @checkAlertMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(msg))
{
    if (msg == "updated")
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-check-circle-fill"></i></strong> Service successfully updated.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    if (msg == "upfailed")
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-circle-fill"></i></strong> Service update failed.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    if (msg == "deleted")
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-check-circle-fill"></i></strong> Service Deleted.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    if (msg == "checked")
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-check-circle-fill"></i></strong> Service Checked.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    if (msg == "termchecked")
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-check-circle-fill"></i></strong> Service Keyword Checked.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}
