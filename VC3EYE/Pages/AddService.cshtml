@page
@model VC3EYE.Pages.AddServiceModel
@{
    ViewData["Title"] = "Add service";
}

<main class="add-service-page">
    <header class="add-service-heading">
        <div>
            <div class="add-service-eyebrow"><i class="bi bi-activity"></i> SERVICE MONITORING</div>
            <h1>Add a service</h1>
            <p>Choose a target and configure how often VC3EYE checks it.</p>
        </div>
        <a asp-page="/ServicesList" class="add-service-back"><i class="bi bi-arrow-left"></i> Services</a>
    </header>

    <form method="post" asp-page-handler="Add" class="add-service-form">
        <div asp-validation-summary="ModelOnly" class="add-service-validation" role="alert"></div>

        <section class="add-service-section">
            <div class="add-service-section-heading"><span><i class="bi bi-globe2"></i></span><div><h2>Service details</h2><p>Identify the service and its network target.</p></div></div>
            <div class="add-service-grid">
                <div class="add-service-field">
                    <label asp-for="currentService.ServiceName">Service name <b>*</b></label>
                    <input asp-for="currentService.ServiceName" class="form-control" placeholder="e.g. Public website" autocomplete="off" />
                    <span asp-validation-for="currentService.ServiceName" class="add-service-field-error"></span>
                </div>
                <div class="add-service-field">
                    <label asp-for="currentService.Location">Location <b>*</b></label>
                    <input asp-for="currentService.Location" class="form-control" placeholder="e.g. Canada / Toronto" />
                    <span asp-validation-for="currentService.Location" class="add-service-field-error"></span>
                </div>
                <div class="add-service-field">
                    <label asp-for="currentService.ServiceURL">Service URL</label>
                    <input asp-for="currentService.ServiceURL" type="text" inputmode="url" class="form-control" placeholder="https://example.com" />
                    <small>Used for HTTP availability checks. Enter a URL or IP address.</small>
                    <span asp-validation-for="currentService.ServiceURL" class="add-service-field-error"></span>
                </div>
                <div class="add-service-field">
                    <label asp-for="currentService.IPAddress">IP address</label>
                    <input asp-for="currentService.IPAddress" class="form-control" placeholder="e.g. 192.0.2.10" inputmode="decimal" />
                    <small>Use this when monitoring a host directly.</small>
                </div>
                <div class="add-service-field">
                    <label asp-for="currentService.Port">Port <span>(optional)</span></label>
                    <input asp-for="currentService.Port" type="number" class="form-control" placeholder="443" min="1" max="65535" />
                    <span asp-validation-for="currentService.Port" class="add-service-field-error"></span>
                </div>
                <div class="add-service-field">
                    <label asp-for="currentService.GeneralInformation">Description <span>(optional)</span></label>
                    <textarea asp-for="currentService.GeneralInformation" class="form-control" rows="3" placeholder="What does this service do?"></textarea>
                </div>
            </div>
        </section>

        <section class="add-service-section">
            <div class="add-service-section-heading"><span class="add-service-monitor-icon"><i class="bi bi-speedometer2"></i></span><div><h2>Monitoring options</h2><p>Set the check cadence and any optional content matching.</p></div></div>
            <div class="add-service-grid">
                <div class="add-service-field">
                    <label asp-for="currentService.CheckInterval">Check interval <b>*</b></label>
                    <div class="add-service-input-suffix"><input asp-for="currentService.CheckInterval" class="form-control" inputmode="numeric" placeholder="5" /><span>minutes</span></div>
                    <small>How often the background monitor checks this service.</small>
                    <span asp-validation-for="currentService.CheckInterval" class="add-service-field-error"></span>
                </div>
                <div class="add-service-field">
                    <label asp-for="currentService.NumOfBackup">Backup count <span>(optional)</span></label>
                    <input asp-for="currentService.NumOfBackup" type="number" class="form-control" min="0" placeholder="0" />
                    <small>Number of backup records to retain.</small>
                </div>
                <div class="add-service-field">
                    <label asp-for="currentService.RSSFeedLink">RSS feed URL <span>(optional)</span></label>
                    <input asp-for="currentService.RSSFeedLink" type="url" class="form-control" placeholder="https://example.com/feed.xml" />
                    <span asp-validation-for="currentService.RSSFeedLink" class="add-service-field-error"></span>
                </div>
                <div class="add-service-field">
                    <label asp-for="currentService.LookupTerm">Page content to find <span>(optional)</span></label>
                    <input asp-for="currentService.LookupTerm" class="form-control" placeholder="A phrase that should appear on the page" />
                    <small>If set, page checks also look for this text.</small>
                </div>
            </div>
            <label class="add-service-important"><input asp-for="currentService.IsImportant" /><span><strong>Mark as important</strong><small>Highlight this service in monitoring views.</small></span></label>
        </section>

        <footer class="add-service-actions">
            <a asp-page="/ServicesList" class="add-service-cancel">Cancel</a>
            <button type="submit" class="add-service-submit"><i class="bi bi-plus-lg"></i> Add service</button>
        </footer>
    </form>
</main>
