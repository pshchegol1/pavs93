@page
@model VC3EYE.Pages.ServiceInfoModel
@using VC3EYE.Data;
@{
    var service = Model.ServiceDetails;
    var serviceId = service.ServiceId;
    var serviceName = service.ServiceName;
    var isDeleted = service.IsDeleted;
    var isPaused = !service.IsActive && !service.IsDeleted;
    var status = isDeleted ? "Deleted" : isPaused ? "Paused" : service.IsRunning ? "Running" : "Down";
    var statusClass = isDeleted || isPaused ? "detail-status-muted" : service.IsRunning ? "detail-status-up" : "detail-status-down";
    var endpoint = string.IsNullOrWhiteSpace(service.Url) ? service.Ipaddress : service.Url;
    var histories = service.ServiceDownHistories.OrderByDescending(x => x.DateAdded).ToList();
    var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var daysThisMonth = DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month);
    var incidentDays = new HashSet<int>();
    foreach (var outage in histories)
    {
        var outageStart = outage.DateAdded.Date;
        var outageEnd = outage.BackUpDateTime?.Date ?? (service.IsRunning ? outageStart : DateTime.Today);
        var rangeStart = outageStart < monthStart ? monthStart : outageStart;
        var rangeEnd = outageEnd > DateTime.Today ? DateTime.Today : outageEnd;
        for (var outageDay = rangeStart; outageDay <= rangeEnd; outageDay = outageDay.AddDays(1))
        {
            incidentDays.Add(outageDay.Day);
        }
    }
    var addedBy = service.User == null ? "Unknown" : $"{service.User.FirstName} {service.User.LastName}";
    ViewData["Title"] = serviceName + " · Service details";
}

<div class="service-detail-page">
    <partial name="_Message" />

    <nav class="detail-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/ServicesList"><i class="bi bi-arrow-left"></i> Services</a>
        <span>/</span><span>@serviceName</span>
    </nav>

    @if (isDeleted)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> This service has been deleted. Restore it to resume monitoring.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <header class="detail-hero">
        <div class="detail-hero-main">
            <span class="detail-service-icon"><i class="bi bi-hdd-network"></i></span>
            <div class="detail-title-group">
                <div class="detail-kicker">SERVICE #@serviceId · @(service.IsInternal ? "INTERNAL" : "EXTERNAL")</div>
                <h1>@serviceName</h1>
                <div class="detail-subtitle"><i class="bi bi-geo-alt"></i> @service.Location <span>·</span> Added by @addedBy</div>
            </div>
        </div>
        <div class="detail-hero-actions">
            <span class="detail-status @statusClass"><span class="detail-status-dot"></span>@status</span>
            @if (User.IsInRole(SiteRoles.Administrator) || User.IsInRole(SiteRoles.User))
            {
                @if (isDeleted)
                {
                    <form method="post" asp-page-handler="UndoDelete" asp-route-serviceid="@serviceId">
                        <input type="hidden" asp-for="ServiceDetails.ServiceName" />
                        <button type="submit" class="detail-action-button"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>
                    </form>
                }
                else
                {
                    <a asp-page="/EditService" asp-route-serviceid="@serviceId" class="detail-action-button"><i class="bi bi-pencil-square"></i> Edit</a>
                    <form method="post" asp-page-handler="PauseService" asp-route-serviceid="@serviceId">
                        <input type="hidden" asp-for="ServiceDetails.ServiceName" />
                        <button type="submit" class="detail-action-button"><i class="bi @(service.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i> @(service.IsActive ? "Pause" : "Resume")</button>
                    </form>
                    @if (service.IsActive)
                    {
                        <button type="button" class="detail-action-button detail-action-icon" data-bs-toggle="modal" data-bs-target="#editStatusModal" title="Edit status" aria-label="Edit service status"><i class="bi bi-sliders"></i></button>
                    }
                }
            }
        </div>
    </header>

    <section class="detail-metrics" aria-label="Service metrics">
        <article class="detail-metric"><span class="detail-metric-icon metric-check"><i class="bi bi-clock-history"></i></span><div><small>Last checked</small><strong>@service.LastTimeChecked.ToString("MMM d, h:mm tt")</strong></div></article>
        <article class="detail-metric"><span class="detail-metric-icon metric-outage"><i class="bi bi-activity"></i></span><div><small>Recorded outages</small><strong>@histories.Count</strong></div></article>
        <article class="detail-metric"><span class="detail-metric-icon metric-interval"><i class="bi bi-stopwatch"></i></span><div><small>Check interval</small><strong>@service.CheckInterval.TotalMinutes.ToString("0.#") min</strong></div></article>
        <article class="detail-metric"><span class="detail-metric-icon @(service.IsIcmpRunning ? "metric-check" : "metric-muted")"><i class="bi bi-wifi"></i></span><div><small>ICMP ping</small><strong>@(service.IsIcmpRunning ? "Reachable" : "No reply")</strong></div></article>
    </section>

    <div class="detail-content-grid">
        <div class="detail-main-column">
            <section class="detail-card detail-check-card">
                <div class="detail-card-heading"><div><div class="detail-kicker">LATEST RESULT</div><h2>Monitoring check</h2></div><span class="detail-result-indicator @(service.IsRunning ? "result-up" : "result-down")"><i class="bi @(service.IsRunning ? "bi-check2-circle" : "bi-exclamation-circle")"></i> @(service.IsRunning ? "Healthy" : "Needs attention")</span></div>
                <p class="detail-check-message">@(string.IsNullOrWhiteSpace(service.NotificationMessage) ? "No check details have been recorded yet." : service.NotificationMessage)</p>
                <div class="detail-check-footer"><span><i class="bi bi-arrow-repeat"></i> Checks every @service.CheckInterval.TotalMinutes.ToString("0.#") minutes</span><span>Last updated @service.LastDateModified.ToString("MMM d, yyyy")</span></div>
            </section>

            <section class="detail-card">
                <div class="detail-card-heading"><div><div class="detail-kicker">THIS MONTH</div><h2>@monthStart.ToString("MMMM yyyy") activity</h2></div><span class="detail-legend"><i></i> outage recorded</span></div>
                <div class="detail-calendar" role="img" aria-label="Outage records for @monthStart.ToString("MMMM")">
                    @for (var day = 1; day <= daysThisMonth; day++)
                    {
                        var hasIncident = incidentDays.Contains(day);
                        var calendarDate = monthStart.AddDays(day - 1);
                        var isFuture = calendarDate > DateTime.Today;
                        var dayClass = isFuture ? "calendar-future" : hasIncident ? "calendar-incident" : calendarDate == DateTime.Today ? (service.IsRunning ? "calendar-current-up" : "calendar-incident") : "calendar-unknown";
                        var dayDescription = hasIncident || (!service.IsRunning && calendarDate == DateTime.Today) ? " · down" : calendarDate == DateTime.Today && service.IsRunning ? " · currently running" : isFuture ? " · future" : " · no outage recorded";
                        <span class="@dayClass" title="@calendarDate.ToString("MMM d")@dayDescription"><small>@day</small></span>
                    }
                </div>
                <div class="detail-calendar-caption"><span><i class="bi bi-info-circle"></i> Red marks recorded outage days; gray means no outage record</span><span>@incidentDays.Count day@(incidentDays.Count == 1 ? "" : "s") affected</span></div>
            </section>

            <section class="detail-card">
                <div class="detail-card-heading"><div><div class="detail-kicker">HISTORY</div><h2>Recent outages</h2></div><span class="detail-history-count">@histories.Count total</span></div>
                @if (histories.Any())
                {
                    <div class="detail-history-list">
                        @foreach (var outage in histories.Take(6))
                        {
                            <article class="detail-history-item">
                                <span class="history-marker @(outage.BackUpDateTime.HasValue ? "history-recovered" : "history-active")"><i class="bi @(outage.BackUpDateTime.HasValue ? "bi-arrow-counterclockwise" : "bi-exclamation-lg")"></i></span>
                                <div class="history-copy"><strong>@(outage.BackUpDateTime.HasValue ? "Recovered" : "Still down")</strong><small>Started @outage.DateAdded.ToString("MMM d, yyyy · h:mm tt")@(outage.BackUpDateTime.HasValue ? $" · recovered {outage.BackUpDateTime.Value:MMM d, h:mm tt}" : "")</small></div>
                                <span class="history-duration">@(outage.ResponseTime.HasValue ? $"{outage.ResponseTime.Value.TotalMinutes:F0} min response" : "")</span>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="detail-no-history"><i class="bi bi-check2-circle"></i><span>No outages have been recorded for this service.</span></div>
                }
            </section>
        </div>

        <aside class="detail-side-column">
            <section class="detail-card detail-endpoint-card">
                <div class="detail-card-heading"><div><div class="detail-kicker">CONNECTION</div><h2>Endpoint</h2></div><span class="endpoint-card-icon"><i class="bi bi-link-45deg"></i></span></div>
                <div class="detail-field"><small>URL</small><span class="detail-mono">@(string.IsNullOrWhiteSpace(service.Url) ? "Not configured" : service.Url)</span></div>
                <div class="detail-field"><small>IP address</small><span class="detail-mono">@(string.IsNullOrWhiteSpace(service.Ipaddress) ? "Not configured" : service.Ipaddress)</span></div>
                <div class="detail-field"><small>Port</small><span>@(service.Port?.ToString() ?? "Not configured")</span></div>
                <div class="detail-field"><small>Location</small><span>@service.Location</span></div>
            </section>

            <section class="detail-card">
                <div class="detail-card-heading"><div><div class="detail-kicker">CONFIGURATION</div><h2>Check settings</h2></div></div>
                <div class="detail-setting-row"><span>Monitor type</span><strong>@(((VC3EYE.Models.ServiceMonitorType)service.MonitorType) switch { VC3EYE.Models.ServiceMonitorType.TcpPort => "TCP port", VC3EYE.Models.ServiceMonitorType.Dns => "DNS lookup", VC3EYE.Models.ServiceMonitorType.SslCertificate => "SSL certificate", VC3EYE.Models.ServiceMonitorType.Api => "API endpoint", _ => "HTTP availability" })</strong></div>
                @if (service.MonitorType == (int)VC3EYE.Models.ServiceMonitorType.Api)
                {
                    <div class="detail-setting-row"><span>API check</span><strong>@service.ApiHttpMethod · expected @service.ExpectedStatusCode</strong></div>
                    @if (!string.IsNullOrWhiteSpace(service.ApiExpectedContent)) { <div class="detail-setting-row"><span>Expected response text</span><strong>@service.ApiExpectedContent</strong></div> }
                }
                @if (service.MonitorType == (int)VC3EYE.Models.ServiceMonitorType.SslCertificate)
                {
                    <div class="detail-setting-row"><span>Certificate warning</span><strong>@service.SslExpiryWarningDays days</strong></div>
                }
                <div class="detail-setting-row"><span>Lookup term</span><strong>@(string.IsNullOrWhiteSpace(service.LookupTerm) ? "None" : service.LookupTerm)</strong></div>
                <div class="detail-setting-row"><span>RSS feed</span><strong>@(string.IsNullOrWhiteSpace(service.RssfeedLink) ? "None" : service.RssfeedLink)</strong></div>
                <div class="detail-setting-row"><span>Backup threshold</span><strong>@(service.NumOfBackup?.ToString() ?? "0")</strong></div>
                <div class="detail-setting-row"><span>Priority</span><strong>@(service.IsImportant ? "Important" : "Standard")</strong></div>
                <div class="detail-setting-row"><span>Teams notifications</span><strong>@(service.NotifyByMsteams ? "On" : "Off")</strong></div>
            </section>

            <section class="detail-card">
                <div class="detail-card-heading"><div><div class="detail-kicker">ABOUT</div><h2>Service details</h2></div></div>
                <p class="detail-description">@(string.IsNullOrWhiteSpace(service.GeneralInformation) ? "No description provided." : service.GeneralInformation)</p>
                <div class="detail-setting-row"><span>Added</span><strong>@service.DateAdded.ToString("MMM d, yyyy")</strong></div>
                <div class="detail-setting-row"><span>Last modified</span><strong>@service.LastDateModified.ToString("MMM d, yyyy")</strong></div>
                <div class="detail-setting-row"><span>Times down</span><strong>@(service.NumOfDownTimes?.ToString() ?? "0")</strong></div>
            </section>
        </aside>
    </div>
</div>

<div class="modal fade" id="editStatusModal" tabindex="-1" aria-labelledby="editStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content detail-status-modal">
            <div class="modal-header"><div><div class="detail-kicker">MANUAL OVERRIDE</div><h5 class="modal-title" id="editStatusModalLabel">Edit service status</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <form method="post" asp-page-handler="EditSatus" asp-route-serviceid="@serviceId">
                <input type="hidden" asp-for="ServiceDetails.ServiceName" />
                <div class="modal-body">
                    <div class="form-check form-switch detail-status-switch"><input class="form-check-input" type="checkbox" asp-for="ServiceDetails.IsRunning" data-status="@service.IsRunning.ToString().ToLower()"><label class="form-check-label" asp-for="ServiceDetails.IsRunning">Service is running</label></div>
                    <label asp-for="ServiceDetails.NotificationMessage"><b>Status note</b></label>
                    <textarea class="form-control" asp-for="ServiceDetails.NotificationMessage" rows="3" placeholder="Add a short note"></textarea>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save status</button></div>
            </form>
        </div>
    </div>
</div>
