@page
@model VC3EYE.Pages.ServicesListModel
@using VC3EYE.Data;
@{
    ViewData["Title"] = "Services";

    string? locationQuery = Request.Query["location"];
    var visibleServices = Model.services?.Where(service => !service.IsDeleted).ToList() ?? new List<VC3EYE.Entities.Service>();
    var runningCount = visibleServices.Count(service => service.IsRunning);
    var downCount = visibleServices.Count - runningCount;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
</head>
<body>
    <partial name="_Message" />
    <main class="services-page container-fluid py-4 px-3 px-lg-4">
        <header class="services-heading">
            <div>
                <div class="services-eyebrow"><i class="bi bi-activity"></i> MONITORING</div>
                <h1>Services</h1>
                <p>Monitor availability and manage your endpoints.</p>
            </div>
            @if (User.IsInRole(SiteRoles.Administrator) || User.IsInRole(SiteRoles.User))
            {
                <a class="btn services-add-button" asp-page="/AddService"><i class="bi bi-plus-lg"></i> Add service</a>
            }
        </header>

        <section class="services-overview" aria-label="Service totals">
            <div class="overview-card"><span class="overview-icon total"><i class="bi bi-hdd-stack"></i></span><div><span class="overview-label">Total services</span><strong>@visibleServices.Count</strong></div></div>
            <div class="overview-card"><span class="overview-icon online"><i class="bi bi-check2-circle"></i></span><div><span class="overview-label">Running</span><strong>@runningCount</strong></div></div>
            <div class="overview-card"><span class="overview-icon offline"><i class="bi bi-exclamation-circle"></i></span><div><span class="overview-label">Down</span><strong>@downCount</strong></div></div>
        </section>

        <section class="services-panel">
            <div class="services-toolbar">
                <div><h2>All services</h2><span class="services-subtitle">@visibleServices.Count endpoint@(visibleServices.Count == 1 ? "" : "s")</span></div>
                <form method="post" class="services-filters" asp-page-handler="Search">
                    <label class="services-search"><i class="bi bi-search"></i><input type="search" placeholder="Search services" asp-for="searchTerm" /><button type="submit" class="services-search-submit" aria-label="Search services"><i class="bi bi-arrow-right"></i></button></label>
                    <div class="dropdown">
                        <button class="btn services-location-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-geo-alt"></i> @(string.IsNullOrEmpty(locationQuery) ? "All locations" : locationQuery)
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/ServicesList">All locations</a></li>
                            @if (Model.LocationName != null)
                            {
                                @foreach (var location in Model.LocationName)
                                {
                                    <li><a class="dropdown-item" href="?location=@Uri.EscapeDataString(location)">@location</a></li>
                                }
                            }
                        </ul>
                    </div>
                    <span asp-validation-for="searchTerm" class="text-danger"></span>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table services-modern-table align-middle mb-0">
                    <thead><tr><th>Service</th><th>Location</th><th>Endpoint</th><th>Status</th><th>ICMP</th><th>Added</th>@if (User.IsInRole(SiteRoles.Administrator) || User.IsInRole(SiteRoles.User)){<th class="text-end">Actions</th>}</tr></thead>
                    <tbody>
                    @if (visibleServices.Any())
                    {
                        foreach (var service in visibleServices)
                        {
                            var endpoint = string.IsNullOrWhiteSpace(service.Url) ? service.Ipaddress : service.Url;
                            var statusClass = service.IsRunning ? "is-running" : "is-down";
                            var hasIp = !string.IsNullOrWhiteSpace(service.Ipaddress);
                            <tr>
                                <td><a class="service-name-link" asp-page="/ServiceInfo" asp-route-serviceid="@service.ServiceId"><span class="service-avatar"><i class="bi bi-hdd-network"></i></span><span><strong>@service.ServiceName</strong><small>Service #@service.ServiceId</small></span></a></td>
                                <td><span class="location-label"><i class="bi bi-geo-alt"></i> @service.Location</span></td>
                                <td><span class="endpoint-value" title="@endpoint">@(string.IsNullOrWhiteSpace(endpoint) ? "Not configured" : endpoint)</span></td>
                                <td><span class="status-pill @statusClass"><span class="status-dot"></span>@(service.IsRunning ? "Running" : "Down")</span></td>
                                <td><span class="icmp-pill @(hasIp && service.IsIcmpRunning ? "icmp-up" : "icmp-muted")"><i class="bi @(hasIp && service.IsIcmpRunning ? "bi-wifi" : "bi-wifi-off")"></i> @(hasIp ? (service.IsIcmpRunning ? "Reachable" : "No reply") : "Not set")</span></td>
                                <td class="date-cell">@service.DateAdded.ToString("MMM d, yyyy")</td>
                                @if (User.IsInRole(SiteRoles.Administrator) || User.IsInRole(SiteRoles.User))
                                {
                                    <td><div class="service-actions">
                                        <a asp-page="/EditService" asp-route-serviceid="@service.ServiceId" class="action-icon" title="Edit service" aria-label="Edit @service.ServiceName"><i class="bi bi-pencil"></i></a>
                                        <form method="post" asp-page="/ServicesList" asp-page-handler="Check" asp-route-serviceid="@service.ServiceId"><button class="action-icon" type="submit" title="Check now" aria-label="Check @service.ServiceName"><i class="bi bi-arrow-clockwise"></i></button></form>
                                        <form method="post" asp-page="/ServicesList" asp-page-handler="Lookup" asp-route-serviceid="@service.ServiceId"><button class="action-icon" type="submit" title="Check page content" aria-label="Check page content for @service.ServiceName"><i class="bi bi-search"></i></button></form>
                                        <form method="post" asp-page="/ServicesList" asp-page-handler="Delete" asp-route-serviceid="@service.ServiceId" onsubmit="return confirmDelete()"><input type="hidden" name="serviceName" value="@service.ServiceName" /><button class="action-icon action-delete" type="submit" title="Delete service" aria-label="Delete @service.ServiceName"><i class="bi bi-trash3"></i></button></form>
                                    </div></td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7"><div class="services-empty"><span><i class="bi bi-inbox"></i></span><strong>No services found</strong><p>Try another search or add a service to get started.</p></div></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    @if (User.IsInRole(SiteRoles.Administrator) || User.IsInRole(SiteRoles.User))
    {
        @if (Model.PausedServices != null && Model.PausedServices.Count() > 0)
        {
            <hr />
            <div class="container-fluid align-content-center">
                <div class="accordion" id="accordionExample1">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo1">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo1" aria-expanded="false" aria-controls="collapseTwo">
                                <h5>Paused Services <span class="badge badge-primary count-deleted">@Model.PausedServices?.Count()</span></h5>
                            </button>
                        </h2>
                        <div id="collapseTwo1" class="accordion-collapse collapse" aria-labelledby="headingTwo1" data-bs-parent="#accordionExample1">
                            <div class="accordion-body">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Name Of Service <i class="bi bi-info-square"></i></th>
                                            <th scope="col">Date Added <i class="bi bi-calendar-plus"></i></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.PausedServices != null)
                                        {
                                            @if (Model.PausedServices != null && Model.PausedServices.Any())
                                            {
                                                foreach (var service in Model.PausedServices)
                                                {
                                                    string paused = service.IsActive ? "not-paused" : "paused";

                                                    <tr class="services-table @paused.ToLower()">
                                                        <td><a asp-page="/ServiceInfo" asp-route-serviceid="@service.ServiceId">@service.ServiceName</a></td>
                                                        <td><a asp-page="/ServiceInfo" asp-route-serviceid="@service.ServiceId">@service.DateAdded</a></td>

                                                        <td>
                                                            <form>
                                                                @{
                                                                    Model.serviceName = service.ServiceName;
                                                                }
                                                                <input hidden asp-for="@Model.serviceName" />
                                                                <a asp-page="/EditService" asp-route-serviceid="@service.ServiceId" class="btn btn-sm btn-secondary"><i class="bi bi-pencil-square"></i> Edit</a>
                                                            </form>

                                                        </td>
                                                    </tr>

                                                }
                                            }
                                            else
                                            {
                                                <tr class="alert alert-warning text-center fw-bold" role="alert">
                                                    <td colspan="6">No Results <i class="bi bi-exclamation-triangle"></i></td>
                                                </tr>
                                            }
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.DeletedServices != null && Model.DeletedServices.Count() > 0)
        {
            <hr />
            <div class="container-fluid align-content-center">
                <div class="accordion" id="accordionExample2">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                <h5>Deleted Services <span class="badge badge-primary count-deleted">@Model.DeletedServices?.Count()</span></h5>
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample2">
                            <div class="accordion-body">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Name Of Service <i class="bi bi-info-square"></i></th>
                                            <th scope="col">Date Added <i class="bi bi-calendar-plus"></i></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.DeletedServices != null)
                                        {
                                            @if (Model.DeletedServices != null && Model.DeletedServices.Any())
                                            {
                                                foreach (var service in Model.DeletedServices)
                                                {


                                                    string status = service.IsRunning ? "Running" : "Down";
                                                    string deleted = service.IsDeleted ? "Deleted" : "Not-Deleted";

                                                    <tr class="services-table @deleted.ToLower()">
                                                        <td><a asp-page="/ServiceInfo" asp-route-serviceid="@service.ServiceId">@service.ServiceName</a></td>
                                                        <td><a asp-page="/ServiceInfo" asp-route-serviceid="@service.ServiceId">@service.DateAdded</a></td>

                                                        <td class="d-flex flex-row">
                                                            <form>
                                                                @{
                                                                    Model.serviceName = service.ServiceName;
                                                                }
                                                                <input hidden asp-for="@Model.serviceName" />




                                                            </form>
                                                            <button type="button" class="btn btn-sm btn-danger ms-1" id="delete-ser-@service.ServiceId" data-name="@service.ServiceName" asp-route-serviceid="@service.ServiceId" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                                                <i class="bi bi-trash3"></i> Delete Permanently
                                                            </button>
                                                        </td>
                                                    </tr>


                                                }
                                            }
                                            else
                                            {
                                                <tr class="alert alert-warning text-center fw-bold" role="alert">
                                                    <td colspan="6">No Results <i class="bi bi-exclamation-triangle"></i></td>
                                                </tr>
                                            }
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        }
    }


    <!-- Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel"><i class="bi bi-exclamation-octagon-fill"></i> Danger Zone</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to permanently delete <b class="service-title"></b> ?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <form method="post" asp-page-handler="DeletePermanently">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
