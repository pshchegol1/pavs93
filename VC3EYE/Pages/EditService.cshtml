@page
@model VC3EYE.Pages.EditServiceModel
@{
    int serviceID = Model.Service.ServiceID;
    ViewData["Title"] = "Edit service";
}

<main class="add-service-page edit-service-page">
    <header class="add-service-heading">
        <div>
            <div class="add-service-eyebrow"><i class="bi bi-sliders"></i> SERVICE CONFIGURATION</div>
            <h1>Edit service</h1>
            <p>Update <strong>@Model.Service.ServiceName</strong> and its monitoring preferences.</p>
        </div>
        <a asp-page="/ServiceInfo" asp-route-serviceid="@serviceID" class="add-service-back"><i class="bi bi-arrow-left"></i> Service details</a>
    </header>

    <partial name="_Message" />
    @if (!Model.Service.IsDeleted)
    {
        <form method="post" asp-page-handler="Edit" asp-route-serviceid="@serviceID" class="add-service-form">
            <div asp-validation-summary="ModelOnly" class="add-service-validation" role="alert"></div>
            <section class="add-service-section">
                <div class="add-service-section-heading"><span><i class="bi bi-globe2"></i></span><div><h2>Service details</h2><p>Keep the identity and target used by your availability checks up to date.</p></div></div>
                <div class="add-service-grid">
                    <div class="add-service-field"><label asp-for="Service.ServiceName">Service name <b>*</b></label><input asp-for="Service.ServiceName" class="form-control" /><span asp-validation-for="Service.ServiceName" class="add-service-field-error"></span></div>
                    <div class="add-service-field"><label asp-for="Service.Location">Location <b>*</b></label><input asp-for="Service.Location" class="form-control" /><span asp-validation-for="Service.Location" class="add-service-field-error"></span></div>
                    <div class="add-service-field"><label asp-for="Service.ServiceURL">Service URL or hostname</label><input asp-for="Service.ServiceURL" type="text" inputmode="url" class="form-control" placeholder="https://example.com" /><small>Enter an HTTP URL for HTTP/API, or a hostname for TCP, DNS, and certificate checks.</small><span asp-validation-for="Service.ServiceURL" class="add-service-field-error"></span></div>
                    <div class="add-service-field"><label asp-for="Service.IPAddress">IP address</label><input asp-for="Service.IPAddress" class="form-control" inputmode="decimal" placeholder="e.g. 192.0.2.10" /></div>
                    <div class="add-service-field service-port-field"><label asp-for="Service.Port">Port <span>(optional; SSL override)</span></label><input asp-for="Service.Port" type="number" class="form-control" min="1" max="65535" /><small class="service-port-help">Optional service port override.</small><span asp-validation-for="Service.Port" class="add-service-field-error"></span></div>
                    <div class="add-service-field"><label asp-for="Service.GeneralInformation">Description <span>(optional)</span></label><textarea asp-for="Service.GeneralInformation" class="form-control" rows="3" placeholder="What does this service do?"></textarea></div>
                </div>
            </section>

            <section class="add-service-section">
                <div class="add-service-section-heading"><span class="add-service-monitor-icon"><i class="bi bi-speedometer2"></i></span><div><h2>Monitoring options</h2><p>Choose how often to check and whether to look for specific content.</p></div></div>
                <div class="add-service-grid">
                    <div class="add-service-field">
                        <label asp-for="Service.MonitorType">Monitor type</label>
                        <select asp-for="Service.MonitorType" class="form-select" id="monitorTypeSelect">
                            <option value="0">HTTP availability</option><option value="1">TCP port</option><option value="2">DNS lookup</option><option value="3">SSL certificate</option><option value="4">API endpoint</option>
                        </select>
                        <small>Choose what VC3EYE should validate for this service.</small>
                    </div>
                    <div class="add-service-field"><label asp-for="Service.CheckInterval">Check interval <b>*</b></label><div class="add-service-input-suffix"><input asp-for="Service.CheckInterval" class="form-control" inputmode="numeric" /><span>minutes</span></div><small>How often the background monitor checks this service.</small><span asp-validation-for="Service.CheckInterval" class="add-service-field-error"></span></div>
                    <div class="add-service-field"><label asp-for="Service.NumOfBackup">Backup count <span>(optional)</span></label><input asp-for="Service.NumOfBackup" type="number" class="form-control" min="0" /><small>Number of backup records to retain.</small></div>
                    <div class="add-service-field"><label asp-for="Service.RSSFeedLink">RSS feed URL <span>(optional)</span></label><input asp-for="Service.RSSFeedLink" type="url" class="form-control" placeholder="https://example.com/feed.xml" /><span asp-validation-for="Service.RSSFeedLink" class="add-service-field-error"></span></div>
                    <div class="add-service-field"><label asp-for="Service.LookupTerm">Page content to find <span>(optional)</span></label><input asp-for="Service.LookupTerm" class="form-control" placeholder="A phrase that should appear on the page" /><small>If set, page checks also look for this text.</small><span asp-validation-for="Service.LookupTerm" class="add-service-field-error"></span></div>
                    <div class="add-service-field monitor-option-ssl"><label asp-for="Service.SslExpiryWarningDays">Certificate expiry warning</label><div class="add-service-input-suffix"><input asp-for="Service.SslExpiryWarningDays" type="number" min="1" max="365" class="form-control" /><span>days</span></div><small>Warning threshold shown in the diagnostic; the service remains healthy until expiry.</small><span asp-validation-for="Service.SslExpiryWarningDays" class="add-service-field-error"></span></div>
                </div>
                <div class="monitor-option-api add-service-api-options"><div class="add-service-grid">
                    <div class="add-service-field"><label asp-for="Service.ApiHttpMethod">API method</label><select asp-for="Service.ApiHttpMethod" class="form-select"><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option></select></div>
                    <div class="add-service-field"><label asp-for="Service.ExpectedStatusCode">Expected status code</label><input asp-for="Service.ExpectedStatusCode" type="number" min="100" max="599" class="form-control" placeholder="200" /><span asp-validation-for="Service.ExpectedStatusCode" class="add-service-field-error"></span></div>
                    <div class="add-service-field"><label asp-for="Service.ApiExpectedContent">Expected response text <span>(optional)</span></label><input asp-for="Service.ApiExpectedContent" class="form-control" placeholder="A value or phrase in the response" /><span asp-validation-for="Service.ApiExpectedContent" class="add-service-field-error"></span></div>
                    <div class="add-service-field"><label asp-for="Service.ApiRequestBody">JSON request body <span>(optional)</span></label><textarea asp-for="Service.ApiRequestBody" class="form-control" rows="3" placeholder="{ }"></textarea><small>Used for POST, PUT, and PATCH requests.</small><span asp-validation-for="Service.ApiRequestBody" class="add-service-field-error"></span></div>
                </div></div>
                <div class="edit-service-options">
                    <label class="add-service-important"><input asp-for="Service.IsImportant" /><span><strong>Important service</strong><small>Highlight this service in monitoring views.</small></span></label>
                    <label class="add-service-important"><input asp-for="Service.IsInternal" /><span><strong>Internal service</strong><small>Mark this service as available only within your network.</small></span></label>
                </div>
            </section>

            <section class="add-service-section">
                <div class="add-service-section-heading"><span class="edit-service-notify-icon"><i class="bi bi-bell"></i></span><div><h2>Notifications</h2><p>Configure Microsoft Teams alerts for this service.</p></div></div>
                <label class="add-service-important"><input asp-for="Service.NotifyByMSTeams" /><span><strong>Send alerts to Microsoft Teams</strong><small>Notify your Teams channel when this service changes state.</small></span></label>
                <div class="add-service-field edit-service-message"><label asp-for="Service.NotificationMessage">Notification message <span>(optional)</span></label><textarea asp-for="Service.NotificationMessage" class="form-control" rows="3" placeholder="Add context to the alert"></textarea><small>Extra text included with notifications for this service.</small></div>
            </section>

            <footer class="add-service-actions">
                <a asp-page="/ServiceInfo" asp-route-serviceid="@serviceID" class="add-service-cancel">Cancel</a>
                <button type="submit" class="add-service-submit"><i class="bi bi-check2"></i> Save changes</button>
            </footer>
        </form>
    }
    else
    {
        <div class="alert alert-warning" role="alert"><i class="bi bi-exclamation-triangle"></i> This service has been deleted and cannot be edited.</div>
    }
</main>

@section Scripts {
    <script>
        (() => {
            const selector = document.getElementById('monitorTypeSelect');
            const update = () => {
                const type = selector.value;
                document.querySelectorAll('.monitor-option-ssl').forEach(el => el.hidden = type !== '3');
                document.querySelectorAll('.monitor-option-api').forEach(el => el.hidden = type !== '4');
                const portLabel = document.querySelector('label[for="Service_Port"]');
                const portHelp = document.querySelector('.service-port-help');
                if (portLabel) portLabel.innerHTML = type === '1' ? 'TCP port <b>*</b>' : 'Port <span>(optional; SSL override)</span>';
                if (portHelp) portHelp.textContent = type === '1' ? 'Port that must accept a TCP connection.' : 'Optional service port override.';
            };
            selector?.addEventListener('change', update);
            update();
        })();
    </script>
}
