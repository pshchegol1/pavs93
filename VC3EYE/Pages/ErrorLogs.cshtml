@page
@model VC3EYE.Pages.ErrorLogsModel
@{
    ViewData["Title"] = "Error logs";
    var startItem = Model.MatchingErrorLogs == 0 ? 0 : (Model.CurrentPage - 1) * 25 + 1;
    var endItem = Math.Min(Model.CurrentPage * 25, Model.MatchingErrorLogs);
}

<main class="error-page">
    <header class="error-heading">
        <div>
            <div class="error-eyebrow"><i class="bi bi-shield-exclamation"></i> SYSTEM DIAGNOSTICS</div>
            <h1>Error logs</h1>
            <p>Investigate recent monitoring and application errors.</p>
        </div>
        <a asp-page="/Logs" class="error-activity-link"><i class="bi bi-journal-text"></i> Activity logs</a>
    </header>

    <section class="error-summary" aria-label="Error totals">
        <article><span class="error-summary-icon"><i class="bi bi-exclamation-triangle"></i></span><div><small>All errors</small><strong>@Model.TotalErrorLogs</strong></div></article>
        <article><span class="error-summary-icon error-archived-icon"><i class="bi bi-archive"></i></span><div><small>Archived</small><strong>@Model.ArchivedErrorLogs</strong></div></article>
        <article><span class="error-summary-icon error-match-icon"><i class="bi bi-funnel"></i></span><div><small>Showing</small><strong>@Model.MatchingErrorLogs</strong></div></article>
    </section>

    <section class="error-panel">
        <form method="get" class="error-toolbar">
            <label class="error-search"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Search errors</span><input type="search" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search error names and details" /></label>
            <label class="error-archive-toggle"><input type="checkbox" name="ShowArchived" value="true" checked="@Model.ShowArchived" onchange="this.form.submit()" /> <span>Show archived</span></label>
            <button class="error-search-button" type="submit"><i class="bi bi-search"></i> Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.ShowArchived)
            {
                <a asp-page="/ErrorLogs" class="error-reset">Clear filters</a>
            }
        </form>

        @if (Model.ErrorLogs.Count > 0)
        {
            <div class="error-table-wrap">
                <table class="error-table">
                    <thead><tr><th scope="col">Error</th><th scope="col">Details</th><th scope="col">First recorded</th></tr></thead>
                    <tbody>
                    @foreach (var log in Model.ErrorLogs)
                    {
                        <tr>
                            <td><span class="error-name"><i class="bi bi-exclamation-circle-fill"></i>@log.ErrorName</span>@if (log.IsArchived) { <span class="error-archived-badge">Archived</span> }</td>
                            <td><pre class="error-description">@log.ErrorDescription</pre></td>
                            <td><time datetime="@log.DateAdded.ToString("O")">@log.DateAdded.ToString("MMM d, yyyy")<small>@log.DateAdded.ToString("h:mm:ss tt")</small></time></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <footer class="error-pagination">
                <span>Showing @startItem–@endItem of @Model.MatchingErrorLogs</span>
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Error log pages">
                        @if (Model.CurrentPage > 1) { <a asp-page="/ErrorLogs" asp-route-p="@(Model.CurrentPage - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-ShowArchived="@Model.ShowArchived"><i class="bi bi-arrow-left"></i> Previous</a> }
                        <span>Page @Model.CurrentPage of @Model.TotalPages</span>
                        @if (Model.CurrentPage < Model.TotalPages) { <a asp-page="/ErrorLogs" asp-route-p="@(Model.CurrentPage + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-ShowArchived="@Model.ShowArchived">Next <i class="bi bi-arrow-right"></i></a> }
                    </nav>
                }
            </footer>
        }
        else
        {
            <div class="error-empty"><span><i class="bi bi-check2-circle"></i></span><h2>@(Model.TotalErrorLogs == 0 ? "No errors recorded" : "No matching errors")</h2><p>@(Model.TotalErrorLogs == 0 ? "The system has not recorded any errors yet." : "Try a different search or change the archived filter.")</p></div>
        }
    </section>
</main>
